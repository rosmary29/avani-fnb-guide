    <!-- ระบบ JavaScript -->
    <script>
        let lang = 'TH';
        let activeTopicId = null;

        // สร้าง Span คาราโอเกะทีละคำ
        function makeKaraokeHTML(engText, phonText) {
            const engWords = engText.split(' ');
            const phonWords = phonText.split(' ');
            const engSpans = engWords.map((w, i) => `<span class="karaoke-word" data-idx="${i}">${w}</span>`).join(' ');
            const phonSpans = phonWords.map((w, i) => `<span class="karaoke-word" data-idx="${i}">${w}</span>`).join(' ');
            return { engSpans, phonSpans };
        }

        // ระบบเล่นเสียงพร้อมไฮไลต์คำแบบคาราโอเกะ
        function speakKaraoke(cleanText, boxId) {
            if (!('speechSynthesis' in window)) {
                alert('เบราว์เซอร์ของคุณไม่รองรับระบบเสียงอ่าน');
                return;
            }
            window.speechSynthesis.cancel();

            const box = document.getElementById(boxId);
            if (!box) return;

            const engWords = box.querySelectorAll('.eng-line .karaoke-word');
            const phonWords = box.querySelectorAll('.phon-line .karaoke-word');

            document.querySelectorAll('.karaoke-word').forEach(el => el.classList.remove('active'));

            const utter = new SpeechSynthesisUtterance(cleanText);
            utter.lang = 'en-US';

            const isSlow = document.getElementById('global-slow')?.checked;
            utter.rate = isSlow ? 0.6 : 0.88;

            const gender = document.getElementById('global-gender')?.value || 'female';
            const voices = window.speechSynthesis.getVoices();
            
            let chosenVoice = voices.find(v => v.lang.includes('en') && (
                gender === 'female' 
                ? /female|zira|susan|samantha|victoria|google us english/i.test(v.name)
                : /male|david|mark|alex|daniel|george/i.test(v.name)
            ));
            if (chosenVoice) utter.voice = chosenVoice;
            utter.pitch = gender === 'female' ? 1.15 : 0.92;

            let wordIdx = 0;
            utter.onboundary = function(e) {
                if (e.name === 'word') {
                    engWords.forEach(el => el.classList.remove('active'));
                    phonWords.forEach(el => el.classList.remove('active'));

                    if (engWords[wordIdx]) engWords[wordIdx].classList.add('active');
                    const phonIdx = Math.min(wordIdx, phonWords.length - 1);
                    if (phonWords[phonIdx]) phonWords[phonIdx].classList.add('active');
                    
                    wordIdx++;
                }
            };

            utter.onend = function() {
                engWords.forEach(el => el.classList.remove('active'));
                phonWords.forEach(el => el.classList.remove('active'));
            };

            window.speechSynthesis.speak(utter);
        }

        // เปิด-ปิดคำศัพท์ย่อยในประโยค
        function toggleSubVocab(id) {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('hidden');
        }

        // เปิด-ปิดเมนู 3 ขีด
        function toggleDrawer() {
            const drawer = document.getElementById('drawer-menu');
            const backdrop = document.getElementById('drawer-backdrop');
            const isOpen = !drawer.classList.contains('translate-x-full');

            if (isOpen) {
                drawer.classList.add('translate-x-full');
                backdrop.classList.add('opacity-0');
                setTimeout(() => backdrop.classList.add('hidden'), 300);
            } else {
                backdrop.classList.remove('hidden');
                setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
                drawer.classList.remove('translate-x-full');
            }
        }

        // สร้างการ์ดประโยคสนทนา
        function createPhraseCard(id, titleTH, titleEN, keyFocus, thSentence, engSentence, phonSentence, transTH, vocabList) {
            const title = lang === 'TH' ? titleTH : titleEN;
            const { engSpans, phonSpans } = makeKaraokeHTML(engSentence, phonSentence);
            const cleanEng = engSentence.replace(/"/g, '').replace(/\(.*?\)/g, '');
            const btnListen = lang === 'TH' ? 'ฟังเสียง' : 'Listen';
            const btnVocab = lang === 'TH' ? 'ดูคำศัพท์' : 'Vocabulary';

            const vocabItemsHTML = vocabList.map(v => `
                <div class="bg-white p-3.5 rounded-xl border border-gray-200">
                    <div class="font-bold text-avani-800 text-xs">${v.word} <span class="text-gray-500 font-normal">(${v.pron})</span></div>
                    <div class="text-gray-700 text-xs mt-1">${lang === 'TH' ? v.meanTH : v.meanEN}</div>
                </div>
            `).join('');

            return `
                <div id="box-${id}" class="bg-white rounded-2xl p-6 border border-gray-200 shadow-2xs space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-gray-100 pb-4">
                        <div class="space-y-1">
                            <span class="inline-block text-[11px] font-bold text-avani-800 bg-avani-100 px-2.5 py-0.5 rounded-md">
                                Key: ${keyFocus}
                            </span>
                            <h4 class="font-bold text-avani-900 text-base">${title}</h4>
                        </div>
                        <div class="flex items-center space-x-2 self-start sm:self-auto shrink-0">
                            <button onclick="toggleSubVocab('subv-${id}')" class="px-3.5 py-2 rounded-xl bg-avani-50 hover:bg-avani-100 text-avani-800 border border-avani-200 text-xs font-bold transition flex items-center space-x-1 cursor-pointer">
                                <span>${btnVocab}</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </button>
                            <button onclick="speakKaraoke('${cleanEng.replace(/'/g, "\\'")}', 'box-${id}')" class="px-4 py-2 rounded-xl bg-avani-700 hover:bg-avani-800 text-white text-xs font-bold transition flex items-center space-x-1.5 cursor-pointer shadow-xs">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 11.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                                <span>${btnListen}</span>
                            </button>
                        </div>
                    </div>

                    ${thSentence ? `
                    <div class="text-xs sm:text-sm text-gray-700 bg-gray-50 p-3.5 rounded-xl border border-gray-200">
                        <span class="font-bold text-avani-800 mr-1">ภาษาไทย (สั้นกระชับ):</span> "${thSentence}"
                    </div>` : ''}

                    <!-- ประโยคภาษาอังกฤษ (ม่วงเข้ม) -->
                    <div class="bg-avani-900 text-white p-5 rounded-xl space-y-1.5">
                        <div class="text-[10px] font-bold text-avani-200 uppercase tracking-widest">Short & Polite English (Karaoke Highlight)</div>
                        <div class="eng-line text-sm sm:text-lg font-semibold leading-relaxed">"${engSpans}"</div>
                    </div>

